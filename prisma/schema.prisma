generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())

  clientAppointments Appointment[] @relation("ClientAppointments")
  barberAppointments Appointment[] @relation("BarberAppointments")
}

model Appointment {
  id          String   @id @default(cuid())
  userId      String
  barberId    String
  status      Status
  scheduledAt DateTime
  createdAt   DateTime @default(now())

  client User @relation("ClientAppointments", fields: [userId], references: [id])
  barber User @relation("BarberAppointments", fields: [barberId], references: [id])

  services   AppointmentService[]
}

model AppointmentService {
  appointmentId String
  serviceId     String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model Service {
  id          String  @id @default(cuid())
  name        String
  price       Decimal @db.Decimal(10, 2)
  duration    Int
  description String?

  active       Boolean @default(true)
  displayOrder Int     @default(0)

  appointments AppointmentService[]
}

enum Role {
  CLIENT
  BARBER
}

enum Status {
  PENDING
  CONFIRMED
  CANCELED
  FINISHED
}
